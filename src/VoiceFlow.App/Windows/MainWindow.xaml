<Window x:Class="VoiceFlow.App.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceFlow" Height="760" Width="1120" MinHeight="600" MinWidth="900"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource ThemeBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18">
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock x:Name="SidebarModelText" Style="{StaticResource Dim}" Margin="14,0,0,4"/>
                    <TextBlock Text="VoiceFlow v1.0" Style="{StaticResource Dim}" Margin="14,0,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,22">
                        <Ellipse Width="12" Height="12" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="VoiceFlow" FontSize="18" FontWeight="Bold" Margin="9,0,0,0"/>
                    </StackPanel>

                    <RadioButton x:Name="NavHome" Style="{StaticResource NavRadio}" GroupName="Nav"
                                 Content="Home" Tag="Home" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavRadio}" GroupName="Nav"
                                 Content="History" Tag="History" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavRadio}" GroupName="Nav"
                                 Content="Dictionary" Tag="Dictionary" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavRadio}" GroupName="Nav"
                                 Content="Snippets" Tag="Snippets" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavRadio}" GroupName="Nav"
                                 Content="Insights" Tag="Insights" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavRadio}" GroupName="Nav"
                                 Content="Settings" Tag="Settings" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="30,24">
            <Grid MaxWidth="860" HorizontalAlignment="Left">

                <!-- ============ HOME ============ -->
                <StackPanel x:Name="HomePanel">
                    <TextBlock Text="Speak, don't type." Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,18" FontSize="13"
                               Text="Hold Ctrl+Win and talk — polished text appears wherever your cursor is. Works in every app."/>

                    <Border x:Name="ModelBanner" Style="{StaticResource Card}" Margin="0,0,0,18"
                            Background="{StaticResource AccentSoftBrush}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="One more step: download the speech model" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="BannerDetail" Style="{StaticResource Dim}" Margin="0,4,0,10"
                                       Text="VoiceFlow transcribes locally on your machine — your voice never leaves this computer."/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BannerDownloadBtn" Content="Download model"
                                        Style="{StaticResource PrimaryButton}" Click="DownloadModel_Click"/>
                                <ProgressBar x:Name="BannerProgress" Width="260" Height="8" Margin="16,0,0,0"
                                             VerticalAlignment="Center" Visibility="Collapsed"
                                             Background="{StaticResource PanelBrush}"
                                             Foreground="{StaticResource AccentBrush}" BorderThickness="0"/>
                                <TextBlock x:Name="BannerPercent" Style="{StaticResource Dim}" Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Try it here" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                            <TextBox x:Name="TryBox" Style="{StaticResource Input}" MinHeight="92"
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,8,0,0"
                                       Text="Click into the box, hold Ctrl+Win, and say: “Hey team, just wanted to give you a quick update on the project.”"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Shortcuts" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                            <UniformGrid Columns="2" Rows="2">
                                <StackPanel Orientation="Horizontal" Margin="0,6">
                                    <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="8,3">
                                        <TextBlock Text="Hold Ctrl + Win" FontFamily="Consolas" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="Push-to-talk" Style="{StaticResource Dim}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6">
                                    <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="8,3">
                                        <TextBlock Text="Ctrl + Win + Space" FontFamily="Consolas" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="Hands-free toggle" Style="{StaticResource Dim}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6">
                                    <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="8,3">
                                        <TextBlock Text="Ctrl + Win + Alt" FontFamily="Consolas" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="Command mode — edit selection by voice" Style="{StaticResource Dim}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6">
                                    <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="8,3">
                                        <TextBlock Text="Esc" FontFamily="Consolas" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="Cancel dictation" Style="{StaticResource Dim}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,10,0,0"
                                       Text="Tip: say “press enter” at the end of a dictation to send the message automatically. Say “new line” or “new paragraph” to format as you speak."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Recent dictations" Style="{StaticResource H2}" Margin="0,4,0,10"/>
                    <ItemsControl x:Name="RecentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}" Style="{StaticResource Dim}"/>
                                        <TextBlock Text="{Binding Text}" Margin="0,4,0,0" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoRecentText" Style="{StaticResource Dim}"
                               Text="Nothing yet — dictate something and it will show up here."/>
                </StackPanel>

                <!-- ============ HISTORY ============ -->
                <StackPanel x:Name="HistoryPanel" Visibility="Collapsed">
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="History" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox x:Name="HistorySearch" Style="{StaticResource Input}" Width="240"
                                     TextChanged="HistorySearch_TextChanged" VerticalAlignment="Center"/>
                            <Button Content="Clear all" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                    Click="ClearHistory_Click" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <ItemsControl x:Name="HistoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,10">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Header}" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Copy" Style="{StaticResource IconButton}"
                                                        Tag="{Binding}" Click="CopyHistory_Click"/>
                                                <Button Content="Delete" Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                                        Tag="{Binding}" Click="DeleteHistory_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Text}" Margin="0,6,0,0" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoHistoryText" Style="{StaticResource Dim}" Text="No dictations found."/>
                </StackPanel>

                <!-- ============ DICTIONARY ============ -->
                <StackPanel x:Name="DictionaryPanel" Visibility="Collapsed">
                    <TextBlock Text="Dictionary" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,18"
                               Text="Teach VoiceFlow your names, jargon and technical terms. Starred and frequently used words get priority during recognition. Optionally map a common misrecognition so it's auto-corrected."/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Word or phrase" Style="{StaticResource Dim}" Margin="0,0,0,4"/>
                                <TextBox x:Name="DictPhraseBox" Style="{StaticResource Input}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Often misheard as (optional)" Style="{StaticResource Dim}" Margin="0,0,0,4"/>
                                <TextBox x:Name="DictMisheardBox" Style="{StaticResource Input}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Add" Style="{StaticResource PrimaryButton}"
                                    VerticalAlignment="Bottom" Click="AddDictionary_Click"/>
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="DictList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton IsChecked="{Binding Starred, Mode=OneWay}" Tag="{Binding}"
                                                          Click="StarDictionary_Click" Cursor="Hand"
                                                          Background="Transparent" BorderThickness="0">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <TextBlock x:Name="Star" Text="☆" FontSize="16" Foreground="#9A9AA8"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Star" Property="Text" Value="★"/>
                                                                <Setter TargetName="Star" Property="Foreground" Value="#F5C518"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <TextBlock Text="{Binding Phrase}" FontSize="13" FontWeight="SemiBold"
                                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}"
                                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Content="Delete" Style="{StaticResource IconButton}"
                                                HorizontalAlignment="Right" Tag="{Binding}" Click="DeleteDictionary_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoDictText" Style="{StaticResource Dim}" Text="Your dictionary is empty."/>
                </StackPanel>

                <!-- ============ SNIPPETS ============ -->
                <StackPanel x:Name="SnippetsPanel" Visibility="Collapsed">
                    <TextBlock Text="Snippets" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,18"
                               Text="Say a short cue and VoiceFlow expands it into the full text — scheduling links, FAQ answers, signatures."/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Spoken cue" Style="{StaticResource Dim}" Margin="0,0,0,4"/>
                            <TextBox x:Name="SnippetTriggerBox" Style="{StaticResource Input}"/>
                            <TextBlock Text="Expands to" Style="{StaticResource Dim}" Margin="0,10,0,4"/>
                            <TextBox x:Name="SnippetContentBox" Style="{StaticResource Input}" MinHeight="70"
                                     TextWrapping="Wrap" AcceptsReturn="True"/>
                            <Button Content="Add snippet" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" Click="AddSnippet_Click"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="SnippetList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                                    <Grid>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Trigger}" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding UsesText}" Style="{StaticResource Dim}" Margin="10,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Preview}" Style="{StaticResource Dim}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Content="Delete" Style="{StaticResource IconButton}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Tag="{Binding}" Click="DeleteSnippet_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoSnippetsText" Style="{StaticResource Dim}" Text="No snippets yet."/>
                </StackPanel>

                <!-- ============ INSIGHTS ============ -->
                <StackPanel x:Name="InsightsPanel" Visibility="Collapsed">
                    <TextBlock Text="Insights" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,18" Text="Your last 30 days of flow."/>

                    <UniformGrid Columns="4">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock x:Name="StatWords" Text="0" FontSize="26" FontWeight="Bold"/>
                                <TextBlock Text="words dictated" Style="{StaticResource Dim}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock x:Name="StatWpm" Text="0" FontSize="26" FontWeight="Bold"/>
                                <TextBlock Text="words per minute" Style="{StaticResource Dim}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock x:Name="StatSessions" Text="0" FontSize="26" FontWeight="Bold"/>
                                <TextBlock Text="dictations" Style="{StaticResource Dim}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="StatStreak" Text="0" FontSize="26" FontWeight="Bold"/>
                                <TextBlock Text="day streak" Style="{StaticResource Dim}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Top apps" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="AppsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <TextBlock Text="{Binding Name}" FontSize="13"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Dim}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoAppsText" Style="{StaticResource Dim}"
                                       Text="Dictate into some apps to see your breakdown."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ SETTINGS ============ -->
                <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                    <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,18"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Dictation" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="Microphone" Style="{StaticResource Dim}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="MicCombo" Style="{StaticResource DarkCombo}"
                                              SelectionChanged="Setting_Changed"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Language" Style="{StaticResource Dim}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="LangCombo" Style="{StaticResource DarkCombo}"
                                              SelectionChanged="Setting_Changed"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Auto cleanup" Style="{StaticResource Dim}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CleanupCombo" Style="{StaticResource DarkCombo}"
                                              SelectionChanged="Setting_Changed"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Speech model (local)" Style="{StaticResource Dim}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ModelCombo" Style="{StaticResource DarkCombo}"
                                              SelectionChanged="Setting_Changed"/>
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock x:Name="ModelStateText" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
                                <Button x:Name="DownloadModelBtn" Content="Download" Style="{StaticResource GhostButton}"
                                        Margin="12,0,0,0" Click="DownloadModel_Click"/>
                                <ProgressBar x:Name="ModelProgress" Width="200" Height="8" Margin="12,0,0,0"
                                             VerticalAlignment="Center" Visibility="Collapsed"
                                             Background="{StaticResource PanelBrush}"
                                             Foreground="{StaticResource AccentBrush}" BorderThickness="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Behavior" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                            <CheckBox x:Name="SoundsCheck" Style="{StaticResource DarkCheck}" Content="Play sounds when dictation starts and stops" Margin="0,4" Click="Setting_Changed"/>
                            <CheckBox x:Name="FlowBarCheck" Style="{StaticResource DarkCheck}" Content="Show the Flow Bar at the bottom of the screen" Margin="0,4" Click="Setting_Changed"/>
                            <CheckBox x:Name="LaunchCheck" Style="{StaticResource DarkCheck}" Content="Launch VoiceFlow at login" Margin="0,4" Click="Setting_Changed"/>
                            <CheckBox x:Name="KeystrokesCheck" Style="{StaticResource DarkCheck}" Content="Insert text with simulated keystrokes (for apps that block paste)" Margin="0,4" Click="Setting_Changed"/>
                            <CheckBox x:Name="RestoreClipCheck" Style="{StaticResource DarkCheck}" Content="Restore my clipboard after inserting text" Margin="0,4" Click="Setting_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Privacy" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,10"
                                       Text="Everything is processed and stored on this computer. VoiceFlow refuses to listen or type in the apps below, and never dictates into password fields."/>
                            <CheckBox x:Name="PasswordPauseCheck" Style="{StaticResource DarkCheck}" Content="Pause in password fields" Margin="0,0,0,10" Click="Setting_Changed"/>
                            <TextBlock Text="Paused apps (comma-separated process names)" Style="{StaticResource Dim}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="PrivacyAppsBox" Style="{StaticResource Input}" Width="480"/>
                                <Button Content="Save" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="SavePrivacyApps_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="AI commands (optional)" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,10"
                                       Text="Command Mode rewrites (“make this more concise”, “translate to Polish”) use an OpenAI-compatible API with your own key. Simple transforms (uppercase, bullet list, polish) work offline without a key. Keys are encrypted with Windows DPAPI."/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="API key" Style="{StaticResource Dim}" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource InputPassword}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Model" Style="{StaticResource Dim}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ApiModelBox" Style="{StaticResource Input}"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Base URL (OpenAI-compatible)" Style="{StaticResource Dim}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ApiUrlBox" Style="{StaticResource Input}" Width="480" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Save AI settings" Style="{StaticResource PrimaryButton}" Click="SaveApi_Click"/>
                                <Button Content="Clear key" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="ClearApi_Click"/>
                                <TextBlock x:Name="ApiStatusText" Style="{StaticResource Dim}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Data" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Open data folder" Style="{StaticResource GhostButton}" Click="OpenDataFolder_Click"/>
                                <Button Content="Clear dictation history" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="ClearHistory_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="DataPathText" Style="{StaticResource Dim}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
