<Window x:Class="VoiceFlow.App.Windows.FlowBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flow Bar"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize">

    <Window.Resources>
        <!-- Small round control button on the pill (minimize). -->
        <Style x:Key="BarCtrlBtn" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="10" Background="#33333F">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#45454F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close variant: red on hover. -->
        <Style x:Key="BarCloseBtn" TargetType="Button" BasedOn="{StaticResource BarCtrlBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="10" Background="#33333F">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#E5484D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Pill" CornerRadius="999" BorderThickness="1"
            BorderBrush="#3A3A46" Background="#F2121218"
            MouseLeftButtonDown="Pill_MouseLeftButtonDown"
            MouseMove="Pill_MouseMove"
            MouseLeftButtonUp="Pill_MouseLeftButtonUp"
            ToolTip="Click to dictate · drag to move"
            Padding="14,7">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <!-- ================= NORMAL (full bar) ================= -->
            <Grid x:Name="NormalView">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <!-- Idle: small resting bars -->
                    <StackPanel x:Name="IdleView" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="IdleBars" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Recording: live waveform + elapsed + mode -->
                    <StackPanel x:Name="RecordingView" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <Ellipse Width="8" Height="8" Fill="#E5484D" VerticalAlignment="Center"/>
                        <StackPanel x:Name="WaveBars" Orientation="Horizontal" Margin="10,0,10,0"
                                    VerticalAlignment="Center" Height="24"/>
                        <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#ECECF1" FontSize="12"
                                   VerticalAlignment="Center" FontFamily="Consolas"/>
                        <Border x:Name="ModeChip" Background="#2B2342" CornerRadius="99" Padding="8,2"
                                Margin="10,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ModeChipText" Text="Command" Foreground="#C4B5FD" FontSize="10.5"/>
                        </Border>
                    </StackPanel>

                    <!-- Processing: pulsing dots -->
                    <StackPanel x:Name="ProcessingView" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="Collapsed" Height="18">
                        <Ellipse x:Name="Dot1" Width="7" Height="7" Fill="#8B5CF6" Margin="2,0" VerticalAlignment="Center"/>
                        <Ellipse x:Name="Dot2" Width="7" Height="7" Fill="#8B5CF6" Margin="2,0" VerticalAlignment="Center"/>
                        <Ellipse x:Name="Dot3" Width="7" Height="7" Fill="#8B5CF6" Margin="2,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Flash message -->
                    <TextBlock x:Name="FlashView" Visibility="Collapsed" Foreground="#ECECF1" FontSize="12"
                               VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- Minimize / Close: a clip-bounded region whose width animates on hover.
                     Starts at 0 width (invisible, no space) and expands to reveal the buttons. -->
                <Grid x:Name="ControlReveal" Grid.Column="1" ClipToBounds="True"
                      Width="0" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left">
                    <StackPanel x:Name="ControlCluster" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button x:Name="MinimizeBtn" Style="{StaticResource BarCtrlBtn}"
                                Click="Minimize_Click" ToolTip="Minimize to a small handle"
                                AutomationProperties.AutomationId="FlowBarMinimize"
                                AutomationProperties.Name="Minimize">
                            <Rectangle Width="9" Height="1.6" RadiusX="1" RadiusY="1" Fill="#D5D5DE"/>
                        </Button>
                        <Button x:Name="CloseBtn" Style="{StaticResource BarCloseBtn}"
                                Click="Close_Click" ToolTip="Quit VoiceFlow"
                                AutomationProperties.AutomationId="FlowBarClose"
                                AutomationProperties.Name="Quit VoiceFlow">
                            <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#E6E6EC" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ================= MINIMIZED (compact handle) ================= -->
            <Grid x:Name="MinimizedView" Visibility="Collapsed" ToolTip="VoiceFlow — click to expand, drag to move">
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <!-- Mic body -->
                        <Path x:Name="MiniMic" Fill="#ECECF1"
                              Data="M12,2 C10.34,2 9,3.34 9,5 L9,11 C9,12.66 10.34,14 12,14 C13.66,14 15,12.66 15,11 L15,5 C15,3.34 13.66,2 12,2 Z"/>
                        <!-- Cradle + stem -->
                        <Path x:Name="MiniMicCradle" Fill="#ECECF1"
                              Data="M7,10 L5.5,10 C5.5,13.53 8.16,16.43 11.25,16.93 L11.25,20 L9.5,20 L9.5,21.5 L14.5,21.5 L14.5,20 L12.75,20 L12.75,16.93 C15.84,16.43 18.5,13.53 18.5,10 L17,10 C17,12.76 14.76,15 12,15 C9.24,15 7,12.76 7,10 Z"/>
                    </Canvas>
                </Viewbox>
                <Ellipse x:Name="MiniRecDot" Width="8" Height="8" Fill="#E5484D"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-2,-2,0" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
