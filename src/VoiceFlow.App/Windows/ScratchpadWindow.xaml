<Window x:Class="VoiceFlow.App.Windows.ScratchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scratchpad — VoiceFlow" Height="420" Width="380" MinHeight="220" MinWidth="260"
        Background="{StaticResource BgBrush}" Topmost="True"
        WindowStartupLocation="Manual">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Scratchpad" Style="{StaticResource H2}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox x:Name="TopmostCheck" Style="{StaticResource DarkCheck}" Content="On top"
                          IsChecked="True" Click="Topmost_Click" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <TextBox x:Name="NoteBox" Grid.Row="1" Style="{StaticResource Input}"
                 TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto" FontSize="13"
                 TextChanged="NoteBox_TextChanged"/>
    </Grid>
</Window>
