<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>VoiceFlow</AssemblyName>
    <RootNamespace>VoiceFlow.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Company>VoiceFlow</Company>
    <Product>VoiceFlow</Product>
    <Description>Voice-to-text everywhere: hold a hotkey, speak, and polished text appears in any app.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF is the primary UI framework; keep WinForms/GDI+ types behind explicit aliases. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoiceFlow.Core\VoiceFlow.Core.csproj" />
  </ItemGroup>

</Project>
