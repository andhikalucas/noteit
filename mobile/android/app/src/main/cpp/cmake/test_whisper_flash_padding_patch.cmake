# Host source-only checks on a temporary copy. Never modifies the active build.
if(NOT DEFINED ORIGINAL_WHISPER_SOURCE OR NOT EXISTS "${ORIGINAL_WHISPER_SOURCE}" OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "Pass ORIGINAL_WHISPER_SOURCE and a fresh TEST_DIR")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}")
set(_copy "${TEST_DIR}/whisper.cpp")
set(_patch "${CMAKE_CURRENT_LIST_DIR}/patch_whisper_flash_padding.cmake")
configure_file("${ORIGINAL_WHISPER_SOURCE}" "${_copy}" COPYONLY)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DWHISPER_AUDIO_CTX_SOURCE=${_copy}" -P "${_patch}"
    RESULT_VARIABLE _first)
if(NOT _first EQUAL 0)
    message(FATAL_ERROR "Combined source transformation failed")
endif()
file(SHA256 "${_copy}" _first_sha)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DWHISPER_AUDIO_CTX_SOURCE=${_copy}" -P "${_patch}"
    RESULT_VARIABLE _second)
file(SHA256 "${_copy}" _second_sha)
if(NOT _second EQUAL 0 OR NOT _first_sha STREQUAL _second_sha)
    message(FATAL_ERROR "Combined patch is not idempotent")
endif()
file(READ "${_copy}" _source)
string(REGEX MATCHALL "ggml_backend_buffer_clear\\(wstate.kv_pad.buffer, 0\\)" _pad_matches "${_source}")
list(LENGTH _pad_matches _pad_count)
string(REGEX MATCHALL "ggml_backend_buffer_clear\\(wstate.kv_cross.buffer, 0\\)" _cross_matches "${_source}")
list(LENGTH _cross_matches _cross_count)
string(FIND "${_source}" "static bool whisper_encode_internal(" _encoder_index)
string(FIND "${_source}" "// Reset flash-attention padding before this encoder pass" _reset_index)
string(FIND "${_source}" "ggml_cgraph * gf = whisper_build_graph_conv(wctx, wstate);" _graph_index)
if(NOT _pad_count EQUAL 1 OR NOT _cross_count EQUAL 1 OR
    NOT _encoder_index LESS _reset_index OR NOT _reset_index LESS _graph_index)
    message(FATAL_ERROR "Padding reset must occur once before encoder graph computation")
endif()
string(REGEX MATCHALL "state->exp_n_audio_ctx = params.audio_ctx" _ctx_matches "${_source}")
list(LENGTH _ctx_matches _ctx_count)
if(NOT _ctx_count EQUAL 1)
    message(FATAL_ERROR "Combined patch changed audio-context assignment count")
endif()
file(APPEND "${_copy}" "\n// unexpected source change\n")
file(SHA256 "${_copy}" _changed_sha)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DWHISPER_AUDIO_CTX_SOURCE=${_copy}" -P "${_patch}"
    RESULT_VARIABLE _rejected OUTPUT_QUIET ERROR_QUIET)
file(SHA256 "${_copy}" _unchanged_sha)
if(_rejected EQUAL 0 OR NOT _changed_sha STREQUAL _unchanged_sha)
    message(FATAL_ERROR "Unexpected combined source was not safely rejected")
endif()
message(STATUS "Flash-padding patch tests passed: combined hash, pre-encode clears, idempotence, fail-closed")
